# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/opendata?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/opendata
# If left empty, the server automatically boots an in-memory Mongo instance for instant zero-config testing!
MONGODB_URI=

# Session Configuration
SESSION_SECRET=open_data_explorer_super_secret_session_key_2026

# Frontend Client URL for CORS and session cookies
CLIENT_URL=http://localhost:5173

# Cache Configuration (TTL in minutes)
CACHE_TTL_MINUTES=60

# Default Seed Credentials
ADMIN_EMAIL=admin@opendata.com
ADMIN_PASSWORD=Admin@123
DEMO_USER_EMAIL=user@opendata.com
DEMO_USER_PASSWORD=User@123
